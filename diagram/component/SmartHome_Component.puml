@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person(user, "User", "Smart Home system user")

System_Boundary(s, "Smart Home System") {
  Container(mobileApp, "Mobile application", $descr="Allows user to manage smart home modules")
  Container(spa, "Single-page application", $descr="Allows user to manage smart home modules")

  Container_Boundary(app, "API Application") {
    Component(dataProc, "Data Processing Service", $descr="Processes data received from smart home modules")
    Component(auth, "Authentication Service", $descr="Handles user authentication and authorization")
    Component(moduleService, "Module Service", $descr="Manages smart home modules")

    ComponentQueue(broker, "Message Broker", $descr="Facilitates communication between services and modules")

    ComponentDb(userDb, "Database", $descr="Stores user data")
    ComponentDb(moduleDb, "Database", $descr="Stores modules data")
  }

}

Container_Ext(module, "Smart Home module", $descr="Connectable module (e.g. heating control module)")

Rel(user, mobileApp, "Uses")
Rel(user, spa, "Uses")

Rel(mobileApp, auth, "Registration and login", "HTTPS/JSON")
Rel(spa, auth, "Registration and login", "HTTPS/JSON")
Rel(mobileApp, moduleService, "Manage modules", "HTTPS/JSON")
Rel(spa, moduleService, "Manage modules", "HTTPS/JSON")

Rel(dataProc, module, "Reads from")
Rel(dataProc, broker, "Writes to",  "HTTPS/JSON")
Rel(dataProc, moduleDb, "Reads from", "SQL")

Rel(moduleService, broker, "Reads from", "HTTPS/JSON")
Rel(moduleService, moduleDb, "Reads from and writes to", "SQL")

Rel(auth, userDb, "Reads from and writes to", "SQL")
@enduml
