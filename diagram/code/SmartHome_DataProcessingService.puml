@startuml
package "Data Processing Service" {

  class DataProcessor {
    + ProcessModuleData(moduleId: string, deviceId: string)
  }

  class MessageBroker {
    + Publish(topic: string, message: string)
    + Subscribe(topic: string, handler: MessageHandler)
  }

  interface MessageHandler {
    + Handle(message: string)
  }

}

class DeviceService {
  + GetDevices(): []Device
}

DataProcessor --> MessageBroker : uses
DataProcessor -right-> DeviceService : uses
DataProcessor ..|> MessageHandler : implements

@enduml
