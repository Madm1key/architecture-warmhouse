@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "User", "Smart Home system user")

System_Boundary(s, "Smart Home System") {
  Container(mobileApp, "Mobile application", $descr="Provides access to the smart home system")
  Container(spa, "Single-page application", $descr="Provides access to the smart home system")
  Container(api, "API Application", $descr="Processes user requests, manages plug-in modules, collects information from modules")

  ContainerDb(db, "Database", $descr="Stores user and device data")
}

Container_Ext(module, "Smart Home module", $descr="Connectable module (e.g. heating control module)")

Rel(user, mobileApp, "Uses")
Rel(user, spa, "Uses")

Rel(mobileApp, api, "Sends requests to", "HTTPS/JSON")
Rel(spa, api, "Sends requests to", "HTTPS/JSON")

Rel_L(api, db, "Reads/writes", "SQL")
Rel_R(api, module, "Sends commands, receives data")
@enduml
